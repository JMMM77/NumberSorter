@using NumberSorter.WebUI.Models.SortedResults

@model SortedResultsDetailsViewModel[];

@{
    ViewData["Title"] = "All Sorted Numbers";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row mb-2">
    <div class="col-md-6 mb-2">
        <a asp-action="Create" class="btn btn-primary">Add New List</a>
    </div>
    <div class="col-md-6 text-end mb-2">
        <form asp-action="ExportToJson" asp-controller="SortedResults" method="post">
            <button type="submit" value="ExportToJson" class="btn btn-primary">Export to JSON</button>
        </form>
    </div>
</div>

<table class="table table-striped">
    <tr>
        <th>Initial Values</th>
        <th>Sorted Values</th>
        <th>Sort Time</th>
        <th>Ordered By</th>
        <th>Actions</th>
    </tr>
    <tbody>
        @foreach (var sortedResult in Model)
        {
            <tr>
                <td>@string.Join(",", sortedResult.InitialValues)</td>
                <td>@string.Join(",", sortedResult.SortedValues)</td>
                <td>@sortedResult.SortTime</td>
                <td>@(sortedResult.IsAscending ? "Ascending" : "Descending")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@sortedResult.Id" class="btn btn-sm btn-primary">Details</a>
                    <a asp-action="Delete" asp-route-id="@sortedResult.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>